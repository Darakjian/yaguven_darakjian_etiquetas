<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_print_label" model="ir.ui.view">
        <field name="name">product.product.form.print.jewelry.label</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet[@name='product_form']" position="before">
                <header>
                    <widget name="print_jewelry_label" string="Print Tag"/>
                </header>
            </xpath>
            <!-- THE TAG'S VALUES, ON SCREEN. The store used to have to print a tag to
                 find out what a tag would say: the values come from attributes scattered
                 across the template and the variant, some of them abbreviated on the way
                 out ("Yellow Gold" -> "YG"), some picked out of a priority list (which
                 stone family wins) or a cascade (Ring Size, or Length, or Diameter...).
                 This page shows the RESULT of all that, cell by cell.

                 The two groups mirror the two columns of the printed spec block, in the
                 same order, so the tab can be read against the tag in hand. -->
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Tag" name="jewelry_tag">
                    <div class="alert alert-info" role="alert">
                        What this variant prints on its Zebra tag, cell by cell: which
                        attribute each one reads, and what comes out. An empty cell prints
                        empty, and says which attribute is missing. Below, the attributes
                        of the model, where a missing value gets filled.
                    </div>
                    <!-- The table is built for the piece in hand: the field captions
                         are the jewellery ones and cannot change per record, so a watch
                         used to read "Clarity: Rubber". Each row says which cell, which
                         attribute it reads, and what it prints. An empty cell names the
                         attribute that is missing. -->
                    <field name="label_tabla" nolabel="1" readonly="1"/>
                    <separator string="Attributes of this model"/>
                    <div class="text-muted">
                        Fill a value here and the cell above stops being empty. These
                        belong to the model, so they reach every version of it: that is
                        right for what describes the piece, which is what the tag prints.
                    </div>
                    <field name="tag_attribute_line_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="attribute_id"/>
                            <field name="value_ids" widget="many2many_tags"
                                   options="{'no_quick_create': True}"
                                   domain="[('attribute_id', '=', attribute_id)]"
                                   context="{'default_attribute_id': attribute_id}"/>
                        </list>
                    </field>
                    <!-- The odd piece that has to disagree with its family. Kept
                         BELOW the attributes on purpose: nine times out of ten an empty
                         cell means a value was never loaded, and that is fixed just
                         above. Changing what the cell reads is the exception, and it
                         reads like one. -->
                    <separator string="Cells changed on this model"
                               groups="stock.group_stock_manager"/>
                    <div class="text-muted" groups="stock.group_stock_manager">
                        Only for the piece that does not fit its family. A cell listed
                        here stops following the family setup and prints the attribute
                        chosen, on every version of this model. Leave the attribute empty
                        for the cell to print nothing at all.
                        <br/>
                        A cell that is NOT listed here keeps following its family, which
                        is set up per category and reaches every piece in the branch.
                    </div>
                    <field name="tag_override_ids" nolabel="1"
                           groups="stock.group_stock_manager">
                        <list editable="bottom">
                            <field name="cell_id"/>
                            <field name="attribute_id"/>
                        </list>
                    </field>
                    <div groups="stock.group_stock_manager">
                        <button type="object" class="btn-link ps-0"
                                name="action_open_category_tag_setup"
                                string="Open the tag setup of this family"/>
                    </div>
                    <group string="Identity block">
                        <group>
                            <field name="default_code" string="SKU" readonly="1"/>
                            <field name="lst_price" string="Price" readonly="1"/>
                        </group>
                        <group>
                            <field name="name" string="Description" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- Do NOT add <chatter/> here: the variant form ALREADY inherits one from
                 the native view. It was added on 2026-08-03 and showed up DUPLICATED on
                 screen. The check beforehand gave a false negative because it searched
                 the arch for "Chatter"/"oe_chatter" when the real tag is lowercase
                 "<chatter/>". To check whether a view has a chatter, search for the
                 lowercase tag. -->
        </field>
    </record>
</odoo>
