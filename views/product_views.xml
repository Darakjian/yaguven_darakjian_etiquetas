<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_print_label" model="ir.ui.view">
        <field name="name">product.product.form.print.jewelry.label</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet[@name='product_form']" position="before">
                <header>
                    <widget name="print_jewelry_label" string="Print Tag"/>
                </header>
            </xpath>
            <!-- NO agregar <chatter/> aca: la ficha de variante YA lo trae de la vista
                 nativa. Se agrego el 2026-08-03 y salio DUPLICADO en pantalla. El chequeo
                 previo dio un falso negativo por buscar "Chatter"/"oe_chatter" en el arch
                 cuando el tag real es "<chatter/>" en minuscula. Para verificar si una
                 vista tiene chatter, buscar el tag en minuscula. -->
        </field>
    </record>
</odoo>
