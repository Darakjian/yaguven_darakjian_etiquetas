<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_print_label" model="ir.ui.view">
        <field name="name">product.product.form.print.jewelry.label</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet[@name='product_form']" position="before">
                <header>
                    <widget name="print_jewelry_label" string="Print Tag"/>
                </header>
            </xpath>
            <!-- La variante SOPORTA chatter (hereda mail.thread) pero su ficha no lo
                 mostraba: sin esto la vista previa de la etiqueta se postea y no la ve
                 nadie. En una joyeria cada variante es una pieza fisica, asi que el
                 historial por variante es util mas alla de la etiqueta. -->
            <xpath expr="//sheet[@name='product_form']" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>
</odoo>
