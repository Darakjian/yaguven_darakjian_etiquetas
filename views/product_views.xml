<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_normal_form_view_print_label" model="ir.ui.view">
        <field name="name">product.product.form.print.jewelry.label</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet[@name='product_form']" position="before">
                <header>
                    <widget name="print_jewelry_label" string="Print Tag"/>
                </header>
            </xpath>
            <!-- THE TAG'S VALUES, ON SCREEN. The store used to have to print a tag to
                 find out what a tag would say: the values come from attributes scattered
                 across the template and the variant, some of them abbreviated on the way
                 out ("Yellow Gold" -> "YG"), some picked out of a priority list (which
                 stone family wins) or a cascade (Ring Size, or Length, or Diameter...).
                 This page shows the RESULT of all that, cell by cell.

                 The two groups mirror the two columns of the printed spec block, in the
                 same order, so the tab can be read against the tag in hand. -->
            <xpath expr="//page[@name='general_information']" position="after">
                <page string="Tag" name="jewelry_tag">
                    <div class="alert alert-info" role="alert">
                        These are the values this variant prints on its Zebra tag.
                        They are read-only: to change one, change the attribute it comes
                        from. An empty box prints empty -- every value has a fixed spot on
                        the tag, and nothing moves up to fill a gap.
                    </div>
                    <group>
                        <group string="Spec block, left column">
                            <field name="label_carat_qty"/>
                            <field name="label_clarity"/>
                            <field name="label_color"/>
                            <field name="label_origin"/>
                        </group>
                        <group string="Spec block, right column">
                            <field name="label_clasp"/>
                            <field name="label_measure"/>
                            <field name="label_karatage"/>
                            <field name="label_metal"/>
                        </group>
                    </group>
                    <group string="Identity block">
                        <group>
                            <field name="default_code" string="SKU" readonly="1"/>
                            <field name="lst_price" string="Price" readonly="1"/>
                        </group>
                        <group>
                            <field name="name" string="Description" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <!-- Do NOT add <chatter/> here: the variant form ALREADY inherits one from
                 the native view. It was added on 2026-08-03 and showed up DUPLICATED on
                 screen. The check beforehand gave a false negative because it searched
                 the arch for "Chatter"/"oe_chatter" when the real tag is lowercase
                 "<chatter/>". To check whether a view has a chatter, search for the
                 lowercase tag. -->
        </field>
    </record>
</odoo>
