<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- THE TAGS OF A WHOLE RECEIPT. Goods arriving, serials being typed and pieces
         needing a tag all happen on this screen, in that order and within minutes of each
         other. Printing here saves walking the same list a second time.

         Only on RECEIPTS: on a delivery the pieces already carry their tag, and a button
         that prints a second one is a way to end up with two. -->
    <record id="stock_picking_form_view_print_label" model="ir.ui.view">
        <field name="name">stock.picking.form.print.jewelry.labels</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <widget name="print_jewelry_label" string="Print Tags"
                        invisible="picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
