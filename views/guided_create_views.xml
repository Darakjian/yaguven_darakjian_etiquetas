<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- The New button on the product views goes to the guided wizard. It is intercepted
       rather than offered alongside because whoever loads a product uses the button that
       is there: a separate menu entry simply does not get used. -->

  <record id="view_product_template_tree_guided" model="ir.ui.view">
    <field name="name">product.template.list.guided</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_tree_view"/>
    <field name="arch" type="xml">
      <list position="attributes">
        <attribute name="js_class">product_guided_list</attribute>
      </list>
    </field>
  </record>

  <record id="view_product_template_kanban_guided" model="ir.ui.view">
    <field name="name">product.template.kanban.guided</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_kanban_view"/>
    <field name="arch" type="xml">
      <kanban position="attributes">
        <attribute name="js_class">product_guided_kanban</attribute>
      </kanban>
    </field>
  </record>

  <record id="view_product_product_tree_guided" model="ir.ui.view">
    <field name="name">product.product.list.guided</field>
    <field name="model">product.product</field>
    <field name="inherit_id" ref="product.product_product_tree_view"/>
    <field name="arch" type="xml">
      <list position="attributes">
        <attribute name="js_class">product_guided_list</attribute>
      </list>
    </field>
  </record>

</odoo>
