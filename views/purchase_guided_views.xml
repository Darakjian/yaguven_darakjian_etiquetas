<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Loading the piece from the purchase itself: the buyer has the supplier's
       information in front of them, which is the moment the data is right. -->
  <record id="view_purchase_order_form_guided" model="ir.ui.view">
    <field name="name">purchase.order.form.guided</field>
    <field name="model">purchase.order</field>
    <field name="inherit_id" ref="purchase.purchase_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='order_line']" position="before">
        <button name="action_yag_nuevo_producto" type="object" class="btn-link"
                icon="fa-plus-circle" string="New product (guided)"
                invisible="state not in ('draft', 'sent')"/>
      </xpath>

      <!-- The product dropdown no longer offers to create one. Typing a name and
           choosing "Create and edit" opens the bare product form, which is exactly what
           this is meant to replace: it asks nothing about the family and lets the piece
           be born empty. The guided button above the lines is the way in. -->
      <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
             position="attributes">
        <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
      </xpath>
    </field>
  </record>

</odoo>
