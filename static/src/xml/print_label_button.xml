<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- The caption comes from the view's `string`, so the receipt can read "Print Tags"
         while a piece reads "Print Tag". It is the plural that tells the person the button
         is about to print the whole list, before the confirmation says how many. -->
    <t t-name="yaguven_darakjian_etiquetas.PrintLabelButton">
        <button type="button"
                class="btn btn-primary"
                t-att-disabled="state.printing"
                t-on-click="onClick">
            <i class="fa fa-print"/>
            <t t-if="state.printing"> Printing...</t>
            <t t-else="1"><t t-esc="' ' + (props.string or 'Print Tag')"/></t>
        </button>
    </t>
</templates>
