<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="yaguven_darakjian_etiquetas.PrintLabelButton">
        <button type="button"
                class="btn btn-primary"
                t-att-disabled="state.printing"
                t-on-click="onClick">
            <i class="fa fa-print"/>
            <t t-if="state.printing"> Imprimiendo...</t>
            <t t-else="1"> Imprimir etiqueta</t>
        </button>
    </t>
</templates>
